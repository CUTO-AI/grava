APP_ENV=production
APP_URL=https://grava.world
# Marken-Domain für nutzerseitige Web-Links in E-Mails (Verify/Reset). Leer =
# APP_URL. Bewusst getrennt, damit Strava-OAuth-Callback + Admin-Host an APP_URL
# hängen bleiben. AASA muss unter dieser Domain ausgeliefert werden (ist der Fall).
PUBLIC_WEB_URL=https://cyberride.world
# Admin-Dashboard-Host (Subdomain, gleicher Docroot). Leer = aus APP_URL abgeleitet (admin.<host>).
ADMIN_HOST=admin.grava.world
API_BASE_PATH=/api/v1
APP_KEY=

# Geheimer Token für die internen HTTP-Endpoints (Migration & Cron), die
# auf Hosting ohne SSH genutzt werden:
#   GET /internal/migrate?token=...
#   GET /internal/cron/cleanup?token=...
#   GET /internal/cron/heatmap?token=...
# Leer lassen = Endpoints deaktiviert (404). Langen Zufallswert verwenden,
# z. B. `php -r "echo bin2hex(random_bytes(24));"`.
INTERNAL_TOKEN=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gravelexplorer
DB_USER=
DB_PASS=
DB_SOCKET=

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@grava.world
MAIL_FROM_NAME=CYBERRIDE
MAIL_ENCRYPTION=tls

ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=5184000
EMAIL_VERIFY_TTL=86400
PASSWORD_RESET_TTL=3600

RATE_LOGIN_MAX=10
RATE_REGISTER_MAX=10
RATE_FORGOT_MAX=5
RATE_VERIFY_RESEND_MAX=5
RATE_WINDOW_SECONDS=900

COOKIE_DOMAIN=grava.world
COOKIE_SECURE=true

# Web-Session sliding TTL (Phase 0). Sekunden; jede authentifizierte
# Aktion erneuert den Ablauf-Timer.
WEB_SESSION_TTL=1800

# M2: Wo liegen die Track-Payloads (GPX/GeoJSON-Files)?
# Default = <repo>/storage/routes. Pfad muss vom Webserver schreibbar sein.
STORAGE_ROUTES_DIR=

# Höhenmeter: Hysterese-Schwelle (Meter) für den Anstieg aus GPX <ele>.
# Änderungen darunter gelten als GPS-Rauschen. Default 3.0 (GPS rauscht mehr
# als ein Barometer). Eine <ge:elevationGain>-Extension hat Vorrang.
ROUTE_ELEVATION_THRESHOLD_M=3.0

# M2 Phase 7: Soft-deleted Routen werden nach diesen Tagen vom
# cron:cleanup hart entfernt (DB + FS). Default 30. Auf 0 setzen
# = sofortiger Hard-Delete im nächsten Cleanup-Lauf.
ROUTES_SOFT_DELETE_GRACE_DAYS=30

# M4c: Gelesene Notifications werden nach diesen Tagen vom
# cron:cleanup entfernt. Default 90.
NOTIFICATIONS_READ_GRACE_DAYS=90

# Push (APNs, Token-based .p8). Siehe backend/PUSH_BACKEND.md.
# Ohne vollständige Konfiguration ist Push deaktiviert (Notifications
# werden weiterhin erzeugt, aber nicht versendet).
#   APNS_ENABLED    – Schalter (true/false).
#   APNS_KEY_ID     – Key-ID des .p8-Keys aus dem Apple Developer Portal.
#   APNS_TEAM_ID    – Apple Team-ID (Default 98JR57G9M7).
#   APNS_BUNDLE_ID  – Topic = Bundle-ID (Default world.grava.app).
#   APNS_KEY_PATH   – Pfad zur .p8-Datei (absolut oder relativ zum Projekt).
#                     Datei NICHT ins Repo committen; außerhalb des Docroots
#                     ablegen und nur lesbar für den Webserver-User.
APNS_ENABLED=false
APNS_KEY_ID=
APNS_TEAM_ID=98JR57G9M7
APNS_BUNDLE_ID=world.grava.app
APNS_KEY_PATH=

# M4d: Wo liegen die Profil-Avatare?
# Default = <repo>/storage/avatars. Pfad muss vom Webserver schreibbar sein.
STORAGE_AVATARS_DIR=

# Crew-Logos (GAME_CREW_LOGO_BACKEND.md): Wo liegen die Crew-Logo-Bilder?
# Default = <repo>/storage/crew-logos. Pfad muss vom Webserver schreibbar sein.
STORAGE_CREW_LOGOS_DIR=

# M4e: Strava-Integration (OAuth2). Leer lassen = Integration nutzt den
# Fake-Client (Dev/Smoke, kein Netz). Für den Live-Betrieb die Werte aus
# der Strava-API-App eintragen. STRAVA_FAKE=1 erzwingt den Fake-Client
# auch bei gesetzter CLIENT_ID (lokales Testen).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=
STRAVA_FAKE=

# M6: Heatmap-Streckenlinien (Map-Matching via Valhalla).
# WICHTIG: Valhalla läuft NUR im Precompute (lokal oder Build-Runner), NIE im
# Request-Pfad. Prod liest zur Laufzeit ausschließlich die vorberechnete Tabelle
# heatmap_edges (Cutover-Modell A — siehe docs/CUTOVER.md §3 und
# docs/PLAN_HEATMAP_MAPMATCH.md §12).
#
# Feature-Flag für den "Strecken"-Layer auf /heatmap. Default aus, damit der
# Web-Code deploybar ist, BEVOR heatmap_edges befüllt wurde. Erst auf true
# setzen, wenn der Smoke-Test `GET /api/v1/heatmap/lines?bbox=…` Features liefert.
HEATMAP_LINES_ENABLED=false
# Nur fürs lokale/Build-seitige Precompute relevant — auf Prod NICHT nötig:
VALHALLA_URL=http://localhost:8002
VALHALLA_COSTING=bicycle

# Stufe 1 Gamification (Territorialspiel)
GAME_ENABLED=true
# Lokaler Valhalla fuer Map-Matching (trace_attributes). Fallback: VALHALLA_URL.
VALHALLA_BASE_URL=http://localhost:8002
# Aggregations-Tuning (vom CLI `cron:heatmap-lines` gelesen):
HEATMAP_LINES_MIN_ROUTES=1
HEATMAP_LINES_RESAMPLE_M=20

# M9: Surface-Check (/surface-check) — projiziert die vorberechneten Crowd-
# Belagsdaten (heatmap_edges) auf eine hochgeladene Fremd-Route. Der Standard-
# Pfad ist rein geometrisch und braucht KEIN Valhalla im Request-Pfad (prod-
# tauglich, liest nur heatmap_edges).
# Schaltet Seite + Nav-Link. Default an.
SURFACE_CHECK_ENABLED=true
# Optionaler präziser "Details"-Pfad via Valhalla-Map-Matching (nutzt VALHALLA_URL).
# Nur dort einschalten, wo Valhalla erreichbar ist (lokal/Staging bzw. nach
# Valhalla-Deploy in Prod, Modell B). Default aus.
SURFACE_CHECK_VALHALLA_ENABLED=false
# Projektions-Tuning: max. Abstand (Meter) Route<->Crowd-Kante für einen Treffer
# und Ausdünnung der Routenpunkte vor dem Matching.
SURFACE_PROJECT_THRESHOLD_M=25
SURFACE_PROJECT_RESAMPLE_M=20

# M7: Empfehlungen / Referrals.
# Basis-URL für den Einlade-Link (https://<base>/i/{code}). Leer lassen =
# es wird APP_URL verwendet. In Produktion auf die Kurz-Domain setzen,
# z. B. https://grava.world.
REFERRAL_LINK_BASE=
# App-Store-Link auf der öffentlichen /i/{code}-Landingpage (optional).
APP_STORE_URL=
# Kommagetrennte E-Mail-Liste der Admins, die /admin/referrals (Werber-
# Auswertung + CSV) sehen dürfen. Leer = niemand (Seite liefert 404).
ADMIN_EMAILS=

# Social-Automatik (Twitter_Automation_Concept.md) — automatische X/Twitter-
# Meldungen aus der Tagesaktivität. Sicher standardmäßig AUS + trocken:
# es wird erst gesendet, wenn SOCIAL_ENABLED=1 UND SOCIAL_DRY_RUN=0.
SOCIAL_ENABLED=false
SOCIAL_DRY_RUN=true
# Kanäle (Multi-Channel, kommagetrennt). Jede Meldung wird auf ALLE gelisteten
# Kanäle ausgespielt. Adapter: 'twitter', 'instagram'. SOCIAL_CHANNEL (Einzahl)
# bleibt als Fallback erhalten.
SOCIAL_CHANNELS=twitter
SOCIAL_CHANNEL=twitter
# Go-Live-Sprache (E4). 'en' zuerst; 'de' per Umschalten (Ausbau F).
SOCIAL_LANG=en
# Free-Tier-Schutz (E8): max. echte Posts pro Tag.
SOCIAL_MAX_POSTS_PER_DAY=1
# Redaktions-Layer (Phase C, §5): Kandidaten, die älter als N Stunden sind,
# verfallen (kein verspätetes Posten). Dasselbe Objekt (z. B. eine Region) wird
# nicht binnen N Tagen erneut gepostet.
SOCIAL_MAX_AGE_HOURS=36
SOCIAL_ENTITY_COOLDOWN_DAYS=3
# Media-Cards (Phase D): gebrandete 1200×675-PNGs an die Posts anhängen.
# Best-effort — schlägt das Rendern/der Upload fehl, geht der Post text-only.
SOCIAL_MEDIA_ENABLED=true
# X/Twitter API v2 — OAuth 1.0a User-Context für EINEN eigenen Marken-Account
# (@cyberride, E9). Im X-Developer-Portal anlegen (App + Access Token mit
# Schreibrecht). Solange leer, bleibt der Publisher im Dry-Run.
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# Instagram (Meta Graph API, Content Publishing) — Business/Creator-Account +
# Meta-App mit instagram_content_publish (App Review) + long-lived Token.
# Instagram lädt die Media-Card per öffentlicher URL (PUBLIC_WEB_URL muss
# öffentlich erreichbar sein). Solange leer, bleibt der Kanal im Dry-Run.
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=v21.0
